# The browser block is published per device type. This template is the
# generic fallback for 64-bit devices (aarch64, amd64); balena prefers a
# matching Dockerfile.<device-type> (Raspberry Pi) or Dockerfile.<arch>
# (armv7hf) over it.
# renovate: datasource=github-tags depName=balenasolutions/browser versioning=loose
ARG BROWSER_VERSION=3.0.4
FROM bh.cr/balenasolutions/browser-generic-%%BALENA_ARCH%%/$BROWSER_VERSION AS base
LABEL maintainer="https://github.com/ketilmo"

COPY kiosk_installer.sh /tmp/

RUN chmod +x /tmp/kiosk_installer.sh && \
    /tmp/kiosk_installer.sh && \
    rm -f /tmp/kiosk_installer.sh

COPY start.sh /usr/src/app/start_custom.sh

RUN chmod +x /usr/src/app/start_custom.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/src/app/start_custom.sh"]
