# renovate: datasource=github-tags depName=balenasolutions/display versioning=loose
ARG DISPLAY_VERSION=0.3.2
FROM bh.cr/balenasolutions/display-%%BALENA_ARCH%%/$DISPLAY_VERSION AS base
LABEL maintainer="https://github.com/ketilmo"

# curl is needed by start.sh to honour DISABLED_SERVICES
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        tini && \
    apt-get clean && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

COPY start.sh /usr/src/app/start.sh

RUN chmod +x /usr/src/app/start.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/src/app/start.sh"]
